# Razorpay API key ID and secret must belong to the same mode (test or live).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Password reset email via Resend. Use a sender domain verified in Resend.
RESEND_API_KEY=re_replace_me
PASSWORD_RESET_FROM_EMAIL=AuctFy <no-reply@example.com>
APP_BASE_URL=http://localhost:3000

# Admin login. Store a bcrypt hash here; never put the password in frontend files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
